# Copy to .env and fill in locally. Never commit .env.

# NASA Earthdata Login (free) — https://urs.earthdata.nasa.gov/
# Username + password are needed for MODIS (AppEEARS). A token alone works for GPM/MERRA-2 (Harmony).
# Alternative: put the same credentials in ~/.netrc (machine urs.earthdata.nasa.gov).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# PostgreSQL + PostGIS (only if D14 is adopted)
DATABASE_URL=postgresql://user:password@localhost:5432/trend_detective

# Frontend -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
