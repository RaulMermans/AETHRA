{
  "name": "@trend-detective/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "predev": "node scripts/copy-cesium-assets.mjs",
    "prebuild": "node scripts/copy-cesium-assets.mjs",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:scenarios": "playwright test --grep \"S0[1-4]\" --repeat-each=3",
    "e2e:capture": "E2E_CAPTURE=1 E2E_VIDEO=0 playwright test --grep @capture"
  },
  "dependencies": {
    "cesium": "^1.140.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
