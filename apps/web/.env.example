# Copy to .env.local and fill in locally. Never commit real tokens.

# Optional Cesium ion token (https://ion.cesium.com/tokens). Enables Cesium World Terrain (3D
# topography) and high-resolution world imagery. Without it the globe uses NASA GIBS Blue Marble
# imagery on a smooth ellipsoid (no terrain).
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Optional AETHRA Core LLM (OpenAI-compatible). Leave empty for deterministic answers.
# Server-only — never NEXT_PUBLIC_. The model may paraphrase or propose intent; it cannot
# compute statistics. Numbers are still taken from EvidenceCards.
AETHRA_LLM_BASE_URL=
AETHRA_LLM_API_KEY=
AETHRA_LLM_MODEL=
AETHRA_LLM_ENABLE_INTENT=0
AETHRA_LLM_ENABLE_PARAPHRASE=0
